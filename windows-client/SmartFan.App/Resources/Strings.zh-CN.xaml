<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <sys:String x:Key="AppSubtitle">散热、灯光与设备状态，一处掌握。</sys:String>
  <sys:String x:Key="DashboardTitle">运行概览</sys:String><sys:String x:Key="LightingTitle">灯光配置</sys:String><sys:String x:Key="CurveTitle">温控曲线</sys:String><sys:String x:Key="ProfilesTitle">场景配置</sys:String><sys:String x:Key="SettingsTitle">高级设置</sys:String><sys:String x:Key="DiagnosticsTitle">接口自检</sys:String>
  <sys:String x:Key="UiText001">SmartFan · 散热控制中心</sys:String>
  <sys:String x:Key="UiText002">让性能，安静释放。</sys:String>
  <sys:String x:Key="UiText003">连接散热底座</sys:String>
  <sys:String x:Key="UiText004">只显示散热器服务</sys:String>
  <sys:String x:Key="UiText005">扫描设备</sys:String>
  <sys:String x:Key="UiText006">连接</sys:String>
  <sys:String x:Key="UiText007">断开连接</sys:String>
  <sys:String x:Key="UiText008">最近使用</sys:String>
  <sys:String x:Key="UiText009">直接连接已保存设备</sys:String>
  <sys:String x:Key="UiText010">风扇控制</sys:String>
  <sys:String x:Key="UiText011">手动 PWM</sys:String>
  <sys:String x:Key="UiText012">应用风扇设置</sys:String>
  <sys:String x:Key="UiText013">手动调试目标 RPM</sys:String>
  <sys:String x:Key="UiText014">发送</sys:String>
  <sys:String x:Key="UiText015">自动模式由设备执行。温控曲线接口待固件对齐。</sys:String>
  <sys:String x:Key="UiText016">重新接入后台</sys:String>
  <sys:String x:Key="UiText017">CPU 温度</sys:String>
  <sys:String x:Key="UiText018">GPU 温度</sys:String>
  <sys:String x:Key="UiText019">底座风扇转速</sys:String>
  <sys:String x:Key="UiText020">转速历史</sys:String>
  <sys:String x:Key="UiText021">最近 5 分钟 · 断连保留空档</sys:String>
  <sys:String x:Key="UiText022">本机状态与遥测</sys:String>
  <sys:String x:Key="UiText023">向 ESP 上报本机状态</sys:String>
  <sys:String x:Key="UiText024">演示模式</sys:String>
  <sys:String x:Key="UiText025">演示数据仅用于界面预览；开启后暂停设备控制和上报。</sys:String>
  <sys:String x:Key="UiText026">ARGB 灯光</sys:String>
  <sys:String x:Key="UiText027">灯效模式</sys:String>
  <sys:String x:Key="UiText028">亮度</sys:String>
  <sys:String x:Key="UiText029">刷新周期（ms）</sys:String>
  <sys:String x:Key="UiText030">应用灯光设置</sys:String>
  <sys:String x:Key="UiText031">读取设备状态</sys:String>
  <sys:String x:Key="UiText032">刷新周期只影响刷新平滑度，不写入场景；设备重启后回到 10 ms。</sys:String>
  <sys:String x:Key="UiText033">灯效参数编辑器</sys:String>
  <sys:String x:Key="UiText034">01  单色常亮</sys:String>
  <sys:String x:Key="UiText035">02  彩虹渐变</sys:String>
  <sys:String x:Key="UiText036">03  单色呼吸</sys:String>
  <sys:String x:Key="UiText037">04  随机闪烁</sys:String>
  <sys:String x:Key="UiText038">05  双色闪烁</sys:String>
  <sys:String x:Key="UiText039">06  自定义呼吸</sys:String>
  <sys:String x:Key="UiText040">07  追逐流光</sys:String>
  <sys:String x:Key="UiText041">08  环绕扫描</sys:String>
  <sys:String x:Key="UiText042">温度 → 目标转速</sys:String>
  <sys:String x:Key="UiText043">PC 上报温度，ESP32 根据曲线计算 RPM 并执行自动控制。曲线可在本地编辑和保存，上传接口待对齐。</sys:String>
  <sys:String x:Key="UiText044">自动控制策略</sys:String>
  <sys:String x:Key="UiText045">温度来源</sys:String>
  <sys:String x:Key="UiText046">CPU / GPU 较高值</sys:String>
  <sys:String x:Key="UiText047">失效后的行为</sys:String>
  <sys:String x:Key="UiText048">保持最后转速；10 秒无有效温度 → PWM 20%</sys:String>
  <sys:String x:Key="UiText049">温度来源、曲线、有效性时间戳与超时策略均需 ESP 接口配合，当前不会在 PC 上执行调速闭环。</sys:String>
  <sys:String x:Key="UiText050">保存到当前场景</sys:String>
  <sys:String x:Key="UiText051">我的场景</sys:String>
  <sys:String x:Key="UiText052">切换场景先加载到本机编辑区，点击同步才写入设备。设备暂不支持的曲线策略仍保存在 JSON 中。</sys:String>
  <sys:String x:Key="UiText053">保存场景</sys:String>
  <sys:String x:Key="UiText054">新建</sys:String>
  <sys:String x:Key="UiText055">删除</sys:String>
  <sys:String x:Key="UiText056">同步当前场景到 ESP</sys:String>
  <sys:String x:Key="UiText057">连接后自动上传当前场景（不再询问）</sys:String>
  <sys:String x:Key="UiText058">关闭自动上传时，每次连接会询问是否同步；选择取消只读取设备状态。</sys:String>
  <sys:String x:Key="UiText059">备份与分享</sys:String>
  <sys:String x:Key="UiText060">导入会验证格式、灯效载荷和曲线。导入后不会自动写入设备。</sys:String>
  <sys:String x:Key="UiText061">导出配置 JSON</sys:String>
  <sys:String x:Key="UiText062">导入配置 JSON</sys:String>
  <sys:String x:Key="UiText063">连接与设备</sys:String>
  <sys:String x:Key="UiText064">蓝牙地址 / DeviceInformation.Id</sys:String>
  <sys:String x:Key="UiText065">地址直连</sys:String>
  <sys:String x:Key="UiText066">自动重连</sys:String>
  <sys:String x:Key="UiText067">初始间隔（秒）</sys:String>
  <sys:String x:Key="UiText068">后台启动后直连上次设备（需先成功连接一次）</sys:String>
  <sys:String x:Key="UiText069">打开后台参数 JSON</sys:String>
  <sys:String x:Key="UiText070">停止后台</sys:String>
  <sys:String x:Key="UiText071">日志级别</sys:String>
  <sys:String x:Key="UiText072">关闭控制面板后，后台仍继续采样、连接和上报。修改参数后点击下方保存。</sys:String>
  <sys:String x:Key="UiText073">MTU 由 Windows 与设备协商，客户端显示实测值。</sys:String>
  <sys:String x:Key="UiText074">重命名</sys:String>
  <sys:String x:Key="UiText075">设为默认</sys:String>
  <sys:String x:Key="UiText076">移除记录</sys:String>
  <sys:String x:Key="UiText077">移除当前设备配对</sys:String>
  <sys:String x:Key="UiText078">外观与常驻</sys:String>
  <sys:String x:Key="UiText079">主题</sys:String>
  <sys:String x:Key="UiText080">强调色（HEX）</sys:String>
  <sys:String x:Key="UiText081">字体大小</sys:String>
  <sys:String x:Key="UiText082">字体</sys:String>
  <sys:String x:Key="UiText083">选择并裁剪壁纸</sys:String>
  <sys:String x:Key="UiText084">清除壁纸</sys:String>
  <sys:String x:Key="UiText085">壁纸透明度</sys:String>
  <sys:String x:Key="UiText086">后台登录自启</sys:String>
  <sys:String x:Key="UiText087">关闭窗口时最小化到托盘</sys:String>
  <sys:String x:Key="UiText088">温度单位</sys:String>
  <sys:String x:Key="UiText089">内存显示单位</sys:String>
  <sys:String x:Key="UiText090">遥测与传感器</sys:String>
  <sys:String x:Key="UiText091">启用定时上报</sys:String>
  <sys:String x:Key="UiText092">间隔（ms）</sys:String>
  <sys:String x:Key="UiText093">RAM / VRAM 协议单位尚待确认，默认不发送这些项。其他有效传感器可正常上报。</sys:String>
  <sys:String x:Key="UiText094">扫描硬件传感器</sys:String>
  <sys:String x:Key="UiText095">手动指定温度传感器（留空使用白名单自动选择）</sys:String>
  <sys:String x:Key="UiText096">监控显卡</sys:String>
  <sys:String x:Key="UiText097">内置风扇数量（可留空自动检测，0～5）</sys:String>
  <sys:String x:Key="UiText098">后台权限说明</sys:String>
  <sys:String x:Key="UiText099">未读到的指标显示不可用，不会混入演示数据。</sys:String>
  <sys:String x:Key="UiText100">保存并应用设置</sys:String>
  <sys:String x:Key="UiText101">关闭控制面板</sys:String>
  <sys:String x:Key="UiText102">27 个固件接口</sys:String>
  <sys:String x:Key="UiText103">默认自检只读取，避免意外写 Flash 或驱动风扇。下方可对选定接口执行带校验的写入。</sys:String>
  <sys:String x:Key="UiText104">运行读取自检</sys:String>
  <sys:String x:Key="UiText105">导出日志</sys:String>
  <sys:String x:Key="UiText106">接口</sys:String>
  <sys:String x:Key="UiText107">属性</sys:String>
  <sys:String x:Key="UiText108">结果</sys:String>
  <sys:String x:Key="UiText109">载荷（HEX）</sys:String>
  <sys:String x:Key="UiText110">选定接口写入（十六进制）</sys:String>
  <sys:String x:Key="UiText111">写入并校验</sys:String>
  <sys:String x:Key="UiText112">目标 RPM 无读接口；PWM 读取恒为 0。这两项只能确认写入应答，不能显示为已读回验证。</sys:String>
  <sys:String x:Key="UiText113">运行日志</sys:String>
  <sys:String x:Key="UiText114">壁纸画面边界</sys:String>
  <sys:String x:Key="UiText115">选择壁纸画面边界</sys:String>
  <sys:String x:Key="UiText116">拖动或缩放选框。这个区域会作为画面源，主窗口仍然按自动填充适配。</sys:String>
  <sys:String x:Key="UiText117">取消</sys:String>
