<Window x:Class="SmartFan.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:SmartFan.App.Controls" xmlns:views="clr-namespace:SmartFan.App.Views" xmlns:sys="clr-namespace:System;assembly=System.Runtime" Title="{DynamicResource UiText001}" Width="1360" Height="930" MinWidth="1060" MinHeight="720" Icon="{DynamicResource SmartFanIcon}" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource UiFontFamily}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid IsHitTestVisible="False" ClipToBounds="True">
      <Ellipse Width="780" Height="660" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-250,-250,0,0" Opacity="0.16"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#9B8CFF" Offset="0" /><GradientStop Color="#009B8CFF" Offset="1" /></RadialGradientBrush></Ellipse.Fill></Ellipse>
      <Ellipse Width="850" Height="760" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-260,-320" Opacity="0.12"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#50BDD4" Offset="0" /><GradientStop Color="#0050BDD4" Offset="1" /></RadialGradientBrush></Ellipse.Fill></Ellipse>
    </Grid>
    <Image x:Name="Wallpaper" Stretch="UniformToFill" Opacity="0.3" IsHitTestVisible="False"><Image.RenderTransform><ScaleTransform ScaleX="1.06" ScaleY="1.06" CenterX="600" CenterY="400" /></Image.RenderTransform></Image>
    <Grid x:Name="MainSurface" Margin="28,24">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,20">
        <StackPanel><StackPanel Orientation="Horizontal"><Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource HighlightBrush}" BorderThickness="1" Margin="0,0,13,0"><Image Source="{DynamicResource SmartFanIcon}" Width="36" Height="36" /></Border><StackPanel><TextBlock Text="SMARTFAN / CONTROL" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,2" /><TextBlock Text="{DynamicResource UiText002}" FontSize="24" FontWeight="SemiBold" /></StackPanel></StackPanel><TextBlock Text="{DynamicResource AppSubtitle}" Foreground="{DynamicResource MutedBrush}" Margin="57,7,0,0" FontSize="12" /></StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}" CornerRadius="20" Padding="18,10"><StackPanel><TextBlock Text="{Binding DataFreshnessText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding ConnectionText,StringFormat=ESP · {0}}" Margin="0,4,0,0"/></StackPanel></Border>
      </Grid>
      <controls:FluidTabControl Grid.Row="1" x:Name="MainTabs">
        <TabItem Header="{DynamicResource DashboardTitle}">
          <views:DashboardView x:Name="Dashboard" Metrics="{Binding DashboardData}" Layout="{Binding Settings.Dashboard}" />
        </TabItem>
        <TabItem Header="{DynamicResource LightingTitle}">
          <controls:SmoothScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,6,12,0">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource UiText026}" Style="{StaticResource SectionTitle}" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="35" /><ColumnDefinition Width="*" /><ColumnDefinition Width="35" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource UiText027}" Style="{StaticResource Hint}" /><ComboBox ItemsSource="{Binding LightModes}" SelectedIndex="{Binding LightModeIndex}" /></StackPanel><StackPanel Grid.Column="2"><DockPanel><TextBlock Text="{DynamicResource UiText028}" Style="{StaticResource Hint}" /><TextBlock Text="{Binding Brightness,StringFormat={}{0:F0} / 255}" HorizontalAlignment="Right" /></DockPanel><Slider Minimum="0" Maximum="255" Value="{Binding Brightness}" IsSnapToTickEnabled="True" TickFrequency="1" /></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="{DynamicResource UiText029}" Style="{StaticResource Hint}" /><ComboBox ItemsSource="{Binding RefreshPeriods}" SelectedItem="{Binding RefreshPeriod}" /></StackPanel></Grid><WrapPanel Margin="0,18,0,0"><Button Content="{DynamicResource UiText030}" Command="{Binding ApplyLightCommand}" IsEnabled="{Binding IsConnected}" Style="{StaticResource PrimaryButton}" /><Button Content="{DynamicResource UiText031}" Command="{Binding ReadDeviceCommand}" IsEnabled="{Binding IsConnected}" /></WrapPanel><TextBlock Text="{Binding DeviceReadback}" Style="{StaticResource Hint}" /><TextBlock Text="{DynamicResource UiText032}" Style="{StaticResource Hint}" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource UiText033}" Style="{StaticResource SectionTitle}" /><ListBox x:Name="EditorModeSelector" SelectionChanged="EditorModeChanged" SelectedIndex="0" ItemContainerStyle="{StaticResource ModeTile}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,-10,12"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBoxItem Content="{DynamicResource UiText034}" /><ListBoxItem Content="{DynamicResource UiText035}" /><ListBoxItem Content="{DynamicResource UiText036}" /><ListBoxItem Content="{DynamicResource UiText037}" /><ListBoxItem Content="{DynamicResource UiText038}" /><ListBoxItem Content="{DynamicResource UiText039}" /><ListBoxItem Content="{DynamicResource UiText040}" /><ListBoxItem Content="{DynamicResource UiText041}" /></ListBox><controls:LightConfigEditor x:Name="LightEditor" /></StackPanel></Border>
          </StackPanel></controls:SmoothScrollViewer>
        </TabItem>
        <TabItem Header="{DynamicResource CurveTitle}">
          <controls:SmoothScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,6,12,0">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource UiText042}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{DynamicResource UiText043}" Style="{StaticResource Hint}" /><controls:FanCurveEditor x:Name="CurveEditor" MinHeight="420" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource UiText044}" Style="{StaticResource SectionTitle}" /><WrapPanel><StackPanel Margin="0,0,25,0"><TextBlock Text="{DynamicResource UiText045}" Style="{StaticResource Hint}" /><ComboBox x:Name="TemperatureSourceBox" SelectedIndex="0" SelectionChanged="TemperatureSourceChanged"><ComboBoxItem Content="{DynamicResource UiText046}" /><ComboBoxItem Content="{DynamicResource UiText017}" /><ComboBoxItem Content="{DynamicResource UiText018}" /></ComboBox></StackPanel><StackPanel><TextBlock Text="{DynamicResource UiText047}" Style="{StaticResource Hint}" /><TextBlock Text="{DynamicResource UiText048}" Margin="0,8,0,0" /></StackPanel></WrapPanel><TextBlock Text="{DynamicResource UiText049}" Style="{StaticResource Hint}" /><Button Content="{DynamicResource UiText050}" Command="{Binding SaveProfileCommand}" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" /></StackPanel></Border>
          </StackPanel></controls:SmoothScrollViewer>
        </TabItem>
        <TabItem Header="{DynamicResource ProfilesTitle}">
          <controls:SmoothScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,6,12,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource UiText051}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{DynamicResource UiText052}" Style="{StaticResource Hint}" /><ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProfile}" Width="320" HorizontalAlignment="Left" /><DockPanel Margin="0,18,0,18" MaxWidth="560" HorizontalAlignment="Left"><TextBox Text="{Binding ProfileName,UpdateSourceTrigger=PropertyChanged}" Width="300" /><Button Content="{DynamicResource UiText053}" Command="{Binding SaveProfileCommand}" Margin="12,0,0,0" /></DockPanel><WrapPanel><Button Content="{DynamicResource UiText054}" Command="{Binding NewProfileCommand}" /><Button Content="{DynamicResource UiText055}" Command="{Binding DeleteProfileCommand}" /><Button Content="{DynamicResource UiText056}" Command="{Binding UploadProfileCommand}" IsEnabled="{Binding IsConnected}" Style="{StaticResource PrimaryButton}" /></WrapPanel><CheckBox Content="{DynamicResource UiText057}" IsChecked="{Binding Settings.Connection.AutoUploadConfiguration}" Margin="0,22,0,8" /><TextBlock Text="{DynamicResource UiText058}" Style="{StaticResource Hint}" /></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource UiText059}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{DynamicResource UiText060}" Style="{StaticResource Hint}" /><WrapPanel><Button Content="{DynamicResource UiText061}" Click="ExportConfig" /><Button Content="{DynamicResource UiText062}" Click="ImportConfig" /></WrapPanel></StackPanel></Border></StackPanel></controls:SmoothScrollViewer>
        </TabItem>
        <TabItem Header="{DynamicResource SettingsTitle}">
          <controls:SmoothScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,6,12,0">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource DevicesTitle}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="{DynamicResource UiText004}" IsChecked="{Binding Settings.Connection.FilterFanService}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <Button Content="{DynamicResource UiText005}" Command="{Binding ScanCommand}" MinHeight="40" VerticalAlignment="Center"/>
                    <Button Content="{DynamicResource UiText006}" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" MinHeight="40" VerticalAlignment="Center"/>
                    <Button Content="{DynamicResource UiText007}" Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsConnected}" MinHeight="40" Margin="0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
                <Border CornerRadius="14" Background="{DynamicResource SurfaceAltBrush}" Padding="6">
                  <Grid>
                    <ListBox x:Name="DeviceResults" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Height="155" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                      <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                          <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,0,0,4"/>
                          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="DeviceItem" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DeviceItem" Property="Background" Value="{DynamicResource SurfaceBrush}"/></Trigger>
                              <Trigger Property="IsSelected" Value="True"><Setter TargetName="DeviceItem" Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter TargetName="DeviceItem" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate></Setter.Value></Setter>
                        </Style>
                      </ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate><DataTemplate><StackPanel>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0"><Run Text="{Binding Address,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SignalStrength,Mode=OneWay}"/><Run Text=" dBm"/></TextBlock>
                      </StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="扫描后在此显示附近的散热底座" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" IsHitTestVisible="False">
                      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Devices.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </Border>
                <Button Content="{DynamicResource UiText009}" Command="{Binding ConnectRecentCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource UiText063}" Style="{StaticResource SectionTitle}" /><TextBlock Text="{DynamicResource UiText064}" Style="{StaticResource Hint}" /><DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource UiText065}" Command="{Binding ConnectAddressCommand}" Margin="12,0,0,0" /><TextBox Text="{Binding ManualAddress,UpdateSourceTrigger=PropertyChanged}" /></DockPanel><WrapPanel Margin="0,12,0,0"><CheckBox Content="{DynamicResource UiText066}" IsChecked="{Binding Settings.Connection.AutoReconnect}" Margin="0,8,20,8" /><TextBlock Text="{DynamicResource UiText067}" Margin="0,0,8,0" /><TextBox Text="{Binding Settings.Connection.ReconnectInitialSeconds}" Width="65" /><TextBlock Text="MTU" Margin="25,0,8,0" /><TextBlock Text="{Binding MtuText}" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding PairingText}" Margin="25,0,0,0" /></WrapPanel><CheckBox Content="{DynamicResource UiText068}" IsChecked="{Binding AutoConnectBackground}" /><WrapPanel><Button Content="{DynamicResource UiText069}" Click="OpenAgentConfig" /><Button Content="{DynamicResource UiText070}" Command="{Binding StopAgentCommand}" /><Button Content="运行日志与诊断" Click="OpenLogs" /><TextBlock Text="{DynamicResource UiText071}" Margin="12,0,10,0" /><ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding Settings.Connection.LogLevel}" Width="150" /></WrapPanel><TextBlock Text="{DynamicResource UiText072}" Style="{StaticResource Hint}" /><TextBlock Text="{DynamicResource UiText073}" Style="{StaticResource Hint}" /><WrapPanel><ComboBox ItemsSource="{Binding RecentDevices}" SelectedItem="{Binding SelectedRecent}" DisplayMemberPath="Name" Width="230" /><TextBox Text="{Binding RecentAlias}" Width="180" Margin="10,0" /><Button Content="{DynamicResource UiText074}" Command="{Binding RenameRecentCommand}" /><Button Content="{DynamicResource UiText075}" Command="{Binding SetDefaultRecentCommand}" /><Button Content="{DynamicResource UiText076}" Command="{Binding RemoveRecentCommand}" /></WrapPanel><Button Content="{DynamicResource UiText077}" Command="{Binding ForgetDeviceCommand}" IsEnabled="{Binding IsConnected}" HorizontalAlignment="Left" Margin="0,14,0,0" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource UiText078}" Style="{StaticResource SectionTitle}" /><WrapPanel><StackPanel Margin="0,0,20,12"><TextBlock Text="{DynamicResource UiText079}" Style="{StaticResource Hint}" /><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Settings.Appearance.ThemeName}" Width="180" /></StackPanel><StackPanel Margin="0,0,20,12"><TextBlock Text="{DynamicResource UiText080}" Style="{StaticResource Hint}" /><TextBox Text="{Binding Settings.Appearance.AccentColor}" Width="130" /></StackPanel><StackPanel Margin="0,0,20,12"><TextBlock Text="{DynamicResource UiText081}" Style="{StaticResource Hint}" /><Slider Minimum="0.85" Maximum="1.25" TickFrequency="0.05" Value="{Binding Settings.Appearance.UiScale}" Width="180" /></StackPanel><StackPanel Margin="0,0,20,12"><TextBlock Text="{DynamicResource UiText082}" Style="{StaticResource Hint}" /><ComboBox x:Name="FontBox" SelectedValuePath="Content" SelectedValue="{Binding Settings.Appearance.UiFontFamily}" Width="190"><ComboBoxItem Content="Microsoft YaHei UI" /><ComboBoxItem Content="Segoe UI" /><ComboBoxItem Content="Microsoft YaHei" /></ComboBox></StackPanel></WrapPanel><WrapPanel><Button Content="{DynamicResource UiText083}" Click="ChooseWallpaper" /><Button Content="{DynamicResource UiText084}" Click="ClearWallpaper" /><TextBlock Text="{DynamicResource UiText085}" Margin="14,0,8,0" /><Slider Width="160" Minimum="0" Maximum="0.7" TickFrequency="0.05" Value="{Binding Settings.Appearance.WallpaperOpacity}" /></WrapPanel><WrapPanel><CheckBox Content="{DynamicResource UiText086}" IsChecked="{Binding Settings.StartWithWindows}" Margin="0,12,25,8" /><CheckBox Content="{DynamicResource UiText087}" IsChecked="{Binding Settings.MinimizeToTray}" /></WrapPanel><WrapPanel Margin="0,10,0,0"><TextBlock Text="{DynamicResource UiText088}" Margin="0,0,10,0" /><ComboBox SelectedValuePath="Content" SelectedValue="{Binding Settings.Appearance.TemperatureUnit}" Width="130"><ComboBoxItem Content="C" /><ComboBoxItem Content="F" /></ComboBox><TextBlock Text="{DynamicResource UiText089}" Margin="25,0,10,0" /><ComboBox SelectedValuePath="Content" SelectedValue="{Binding Settings.Appearance.MemoryUnit}" Width="130"><ComboBoxItem Content="MiB" /><ComboBoxItem Content="GiB" /></ComboBox></WrapPanel></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource UiText090}" Style="{StaticResource SectionTitle}" /><WrapPanel><CheckBox Content="{DynamicResource UiText091}" IsChecked="{Binding TelemetryEnabled}" Margin="0,8,20,8" /><TextBlock Text="{DynamicResource UiText092}" Margin="0,0,8,0" /><ComboBox x:Name="IntervalBox" SelectedValuePath="Content" Width="130"><ComboBoxItem Content="500" /><ComboBoxItem Content="1000" /><ComboBoxItem Content="2000" /><ComboBoxItem Content="5000" /></ComboBox></WrapPanel><TextBlock Text="{DynamicResource UiText093}" Style="{StaticResource Hint}" /><WrapPanel x:Name="TelemetryItems" /><WrapPanel Margin="0,14,0,12"><Button Content="查看硬件传感器" Click="OpenSensors" /><Button Content="重新枚举传感器" Command="{Binding RefreshSensorsCommand}" /></WrapPanel><TextBlock Text="{DynamicResource UiText095}" Style="{StaticResource Hint}" /><ComboBox x:Name="CpuSensorBox" ItemsSource="{Binding CpuTemperatureSensors}" SelectedValuePath="Id" SelectedValue="{Binding Settings.Telemetry.SensorPreferences.CpuTemperatureSensorId,Mode=OneWay,TargetNullValue={x:Static sys:String.Empty}}" SelectionChanged="CpuSensorChanged" IsEditable="False" Margin="0,0,0,10" /><ComboBox x:Name="GpuSensorBox" ItemsSource="{Binding GpuTemperatureSensors}" SelectedValuePath="Id" SelectedValue="{Binding Settings.Telemetry.SensorPreferences.GpuTemperatureSensorId,Mode=OneWay,TargetNullValue={x:Static sys:String.Empty}}" SelectionChanged="GpuSensorChanged" IsEditable="False" /><TextBlock Text="{DynamicResource UiText096}" Style="{StaticResource Hint}" /><ComboBox x:Name="GpuAdapterBox" SelectionChanged="GpuAdapterChanged" ItemsSource="{Binding GpuAdapters}" DisplayMemberPath="HardwareName" SelectedValuePath="HardwareId" SelectedValue="{Binding Settings.Telemetry.SensorPreferences.GpuHardwareId,Mode=OneWay,TargetNullValue={x:Static sys:String.Empty}}" /><WrapPanel Margin="0,12,0,0"><TextBlock Text="{DynamicResource UiText097}" Margin="0,0,12,0" /><TextBox Width="60" Text="{Binding Settings.Telemetry.SensorPreferences.ManualFanCount}" /></WrapPanel><TextBlock Text="{Binding SensorSummary}" Style="{StaticResource Hint}" FontSize="11" /><TextBlock Text="CPU 温度采集" Style="{StaticResource SectionTitle}" Margin="0,18,0,6" /><TextBlock Text="{Binding CpuTemperatureStatusText}" TextWrapping="Wrap" /><TextBlock Text="{Binding HardwareMonitorDetail}" Style="{StaticResource Hint}" FontSize="12" /><TextBlock Text="{Binding VendorSensorStatusText}" Style="{StaticResource Hint}" FontSize="12" /><Button Content="查看 CPU 温度采集说明" Click="ShowCpuTemperatureHelp" HorizontalAlignment="Left" /><TextBlock Text="{DynamicResource UiText099}" Style="{StaticResource Hint}" /></StackPanel></Border>
            <WrapPanel Margin="0,4,0,24"><Button Content="{DynamicResource UiText100}" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" /><Button Content="{DynamicResource UiText101}" Click="ExitApplication" /></WrapPanel>
          </StackPanel></controls:SmoothScrollViewer>
        </TabItem>
        <TabItem Header="{DynamicResource DiagnosticsTitle}">
          <views:DiagnosticsView LogsRequested="OpenLogs" ExportLogsRequested="ExportLogs" />
        </TabItem>
      </controls:FluidTabControl>
      <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,6" Margin="0,12,0,0"><Grid><TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,160,0" /><ProgressBar Width="130" Height="3" IsIndeterminate="{Binding Busy}" HorizontalAlignment="Right" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource AccentBrush}" /></Grid></Border>
    </Grid>
  </Grid>
</Window>













