<UserControl x:Class="SmartFan.App.Controls.DashboardFanControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SmartFan.App.Controls">
  <UserControl.Resources><local:FanTemperatureSummaryConverter x:Key="FanTemperatureSummary"/></UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ComboBox x:Name="ModePicker" Grid.ColumnSpan="2" ItemsSource="{Binding FanModes}" SelectedIndex="{Binding FanModeIndex}" MinWidth="0"/>
    <Grid x:Name="ModeContent" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7">
      <StackPanel x:Name="ManualPanel" VerticalAlignment="Center">
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding FanModeIndex}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding FanModeIndex}" Value="2"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <DockPanel x:Name="ManualReadout"><TextBlock x:Name="ManualLabel" Text="手动 PWM" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock x:Name="ManualValue" Text="{Binding ManualPwm,StringFormat={}{0:0}%}" HorizontalAlignment="Right" FontSize="17"/></DockPanel>
        <Slider x:Name="ManualSlider" Minimum="0" Maximum="100" Value="{Binding ManualPwm}" IsSnapToTickEnabled="True" TickFrequency="1" MinWidth="0" Margin="0,4,0,0"/>
        <TextBlock x:Name="ManualHint" Text="调节占空比，点击应用后发送至散热底座。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel x:Name="AutomaticPanel" VerticalAlignment="Center">
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FanModeIndex}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBlock x:Name="AutomaticTemperature" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,5">
          <TextBlock.Text><MultiBinding Converter="{StaticResource FanTemperatureSummary}"><Binding Path="SelectedProfile"/><Binding Path="CpuTemperatureValue"/><Binding Path="GpuTemperatureValue"/><Binding Path="DemoMode"/><Binding Path="Settings.Appearance.TemperatureUnit"/><Binding Path="TelemetryIsStale" FallbackValue="False"/><Binding Path="IsCompact" RelativeSource="{RelativeSource AncestorType=local:DashboardFanControl}"/></MultiBinding></TextBlock.Text>
        </TextBlock>
        <TextBlock x:Name="AutomaticHint" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="电脑分别上报 CPU / GPU 温度，设备自动策略待固件对齐。"/><Style.Triggers><DataTrigger Binding="{Binding TelemetryEnabled,FallbackValue=False}" Value="False"><Setter Property="Text" Value="温度遥测已暂停；设备自动策略待固件对齐。"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <DockPanel x:Name="CurveRow" LastChildFill="True" Margin="0,3,0,0"><Button x:Name="CurveButton" DockPanel.Dock="Right" Content="编辑曲线 ↗" ToolTip="编辑本机温控曲线；曲线与温度来源上传接口尚待固件对齐" Click="OpenCurveClicked" Padding="8,4" Margin="9,0,0,0" FontSize="11"/><TextBlock x:Name="CurveHint" Text="曲线与来源仅在本机预览" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
      </StackPanel>
      <StackPanel x:Name="FullSpeedPanel" VerticalAlignment="Center">
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FanModeIndex}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBlock x:Name="FullSpeedTitle" Text="全速运行" FontSize="23" Margin="0,0,0,6"/>
        <TextBlock x:Name="FullSpeedHint" Text="应用后请求 ESP32 切换至全速模式。" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
      </StackPanel>
    </Grid>
    <Button x:Name="ApplyButton" Grid.Row="2" Grid.ColumnSpan="2" Content="应用风扇设置" Command="{Binding ApplyFanCommand}" Margin="0" Padding="12,7" ToolTip="{Binding FanControlStatusText,FallbackValue=修改模式后点击应用发送。}">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="IsEnabled" Value="False"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsConnected}" Value="True"/><Condition Binding="{Binding Busy}" Value="False"/><Condition Binding="{Binding DemoMode}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="True"/></MultiDataTrigger></Style.Triggers></Style></Button.Style>
    </Button>
    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" x:Name="ActionStatus" Text="{Binding FanControlStatusText,FallbackValue=修改模式后点击应用发送。}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" ToolTip="{Binding Text,RelativeSource={RelativeSource Self},Mode=OneWay}"/>
  </Grid>
</UserControl>
