<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SmartFan</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SmartFan.Core\SmartFan.Core.csproj" />
    <ProjectReference Include="..\SmartFan.Runtime\SmartFan.Runtime.csproj" />
    <ProjectReference Include="..\SmartFan.Agent\SmartFan.Agent.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <Target Name="CopyAgentExecutable" AfterTargets="Build" Condition="'$(SkipAgentCopy)' != 'true'">
    <ItemGroup><AgentFiles Include="..\SmartFan.Agent\bin\$(Configuration)\$(TargetFramework)\SmartFan.Agent.exe;..\SmartFan.Agent\bin\$(Configuration)\$(TargetFramework)\SmartFan.Agent.dll;..\SmartFan.Agent\bin\$(Configuration)\$(TargetFramework)\SmartFan.Agent.deps.json;..\SmartFan.Agent\bin\$(Configuration)\$(TargetFramework)\SmartFan.Agent.runtimeconfig.json" /></ItemGroup>
    <Copy SourceFiles="@(AgentFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
