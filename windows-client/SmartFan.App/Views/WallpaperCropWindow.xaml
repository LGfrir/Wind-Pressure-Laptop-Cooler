<Window x:Class="SmartFan.App.Views.WallpaperCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UiText114}"
        Width="900"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#111827"
        Foreground="White">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource UiText115}" FontSize="22" FontWeight="{DynamicResource UiHeadingWeight}" />
            <TextBlock Text="{DynamicResource UiText116}"
                       Foreground="#CBD5E1"
                       Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="#020617"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Canvas x:Name="PreviewCanvas"
                    Background="#020617"
                    MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown"
                    MouseMove="PreviewCanvas_MouseMove"
                    MouseLeftButtonUp="PreviewCanvas_MouseLeftButtonUp"
                    SizeChanged="PreviewCanvas_SizeChanged">
                <Image x:Name="WallpaperPreview" Stretch="Uniform" />
                <Rectangle x:Name="CropRectangle"
                           Stroke="#38BDF8"
                           StrokeThickness="2.5"
                           Fill="#2238BDF8" />
            </Canvas>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="CropInfoText"
                       VerticalAlignment="Center"
                       Foreground="#CBD5E1" />
            <Button Grid.Column="1"
                    Content="{DynamicResource UiText117}"
                    MinWidth="92"
                    Padding="14,8"
                    Click="CancelButton_Click" />
            <Button Grid.Column="3"
                    Content="{DynamicResource UiText118}"
                    MinWidth="108"
                    Padding="14,8"
                    Background="#2563EB"
                    Foreground="White"
                    BorderBrush="#2563EB"
                    Click="ApplyButton_Click" />
        </Grid>
    </Grid>
</Window>


