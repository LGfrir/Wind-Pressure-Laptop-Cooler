<UserControl x:Class="SmartFan.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SmartFan.App.Controls">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    <Style x:Key="DiagnosticDisclosure" TargetType="controls:DisclosureToggle">
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="controls:DisclosureToggle">
        <Border x:Name="Shell" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9">
          <Path x:Name="PART_Arrow" Data="M 0,0 L 5,5 L 0,10" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin=".5,.5"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DiagnosticCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="10,9"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self},Mode=OneWay}"/>
    </Style>
    <Style x:Key="FieldText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Margin" Value="0,6,12,6"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
  </UserControl.Resources>
  <Grid Margin="0,6,12,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="130"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="{DynamicResource UiText102}" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="{DynamicResource UiText103}" Style="{StaticResource Hint}"/>
      <WrapPanel Margin="0,0,0,14">
        <Button Content="{DynamicResource UiText104}" Command="{Binding RunDiagnosticsCommand}" IsEnabled="{Binding IsConnected}" Style="{StaticResource PrimaryButton}"/>
        <Button Content="运行日志与诊断" Click="OpenLogs"/><Button Content="{DynamicResource UiText105}" Click="ExportLogs"/>
        <TextBlock Text="点击接口左侧箭头查看字段解析" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0"/>
      </WrapPanel>
    </StackPanel>
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="5" ClipToBounds="True">
      <DataGrid x:Name="DiagnosticsGrid" ItemsSource="{Binding Diagnostics}" SelectedItem="{Binding SelectedDiagnostic}" AutoGenerateColumns="False" IsReadOnly="True"
                Background="Transparent" Foreground="{DynamicResource TextBrush}" RowBackground="Transparent" AlternatingRowBackground="{DynamicResource SurfaceAltBrush}"
                GridLinesVisibility="None" BorderThickness="0" HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                SelectionMode="Single" SelectionUnit="FullRow" AreRowDetailsFrozen="True"
                EnableRowVirtualization="False" EnableColumnVirtualization="False" ScrollViewer.CanContentScroll="False">
        <DataGrid.Resources>
          <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Padding" Value="10,12"/><Setter Property="FontWeight" Value="{DynamicResource UiBodyWeight}"/><Setter Property="BorderThickness" Value="0"/></Style>
          <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger></Style.Triggers></Style>
        </DataGrid.Resources>
        <DataGrid.RowStyle><Style TargetType="DataGridRow">
          <Setter Property="MinHeight" Value="42"/><Setter Property="DetailsVisibility" Value="Collapsed"/>
          <Style.Triggers><DataTrigger Binding="{Binding IsExpanded,Mode=OneWay}" Value="True"><Setter Property="DetailsVisibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style></DataGrid.RowStyle>
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="42" CanUserResize="False"><DataGridTemplateColumn.CellTemplate><DataTemplate>
            <controls:DisclosureToggle Style="{StaticResource DiagnosticDisclosure}" IsChecked="{Binding IsExpanded,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                       Click="DisclosureClicked"
                                       AutomationProperties.Name="{Binding Name,StringFormat={}展开或收起 {0} 的解析}" ToolTip="展开 / 收起字段解析" HorizontalAlignment="Center"/>
          </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="{DynamicResource UiText106}" Binding="{Binding Name,Mode=OneWay}" Width="190" ElementStyle="{StaticResource DiagnosticCell}"/>
          <DataGridTextColumn Header="{DynamicResource UiText107}" Binding="{Binding Properties,Mode=OneWay}" Width="135" ElementStyle="{StaticResource DiagnosticCell}"/>
          <DataGridTextColumn Header="{DynamicResource UiText108}" Binding="{Binding Result,Mode=OneWay}" Width="*" MinWidth="160" ElementStyle="{StaticResource DiagnosticCell}"/>
          <DataGridTextColumn Header="{DynamicResource UiText109}" Binding="{Binding Hex,Mode=OneWay}" Width="250"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource DiagnosticCell}"><Setter Property="FontFamily" Value="{DynamicResource UiCodeFontFamily}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
        </DataGrid.Columns>
        <DataGrid.RowDetailsTemplate><DataTemplate>
          <Border Background="{DynamicResource SurfaceAltBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="42,0,10,12">
              <StackPanel Margin="0,0,10,0">
                <DockPanel LastChildFill="True"><TextBlock Text="{Binding ParseStatus,Mode=OneWay}" DockPanel.Dock="Right" Margin="16,0,0,0" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding Summary,Mode=OneWay}" FontWeight="{DynamicResource UiHeadingWeight}" TextWrapping="Wrap"/></DockPanel>
                <TextBlock Text="{Binding PayloadSource,Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,3"/>
                <TextBlock Text="{Binding LayoutDescription,Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,6"/>
                <Grid Visibility="{Binding HasPayload,Converter={StaticResource BoolVisibility},Mode=OneWay}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                  <TextBlock Text="字段" Style="{StaticResource FieldText}" Foreground="{DynamicResource MutedBrush}"/>
                  <TextBlock Grid.Column="1" Text="解析值" Style="{StaticResource FieldText}" Foreground="{DynamicResource MutedBrush}"/>
                  <TextBlock Grid.Column="2" Text="类型 / 编码" Style="{StaticResource FieldText}" Foreground="{DynamicResource MutedBrush}"/>
                  <TextBlock Grid.Column="3" Text="字节偏移" Style="{StaticResource FieldText}" Foreground="{DynamicResource MutedBrush}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Fields,Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name,Mode=OneWay}" Style="{StaticResource FieldText}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value,Mode=OneWay}" Style="{StaticResource FieldText}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Type,Mode=OneWay}" Style="{StaticResource FieldText}" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Bytes,Mode=OneWay}" Style="{StaticResource FieldText}" Foreground="{DynamicResource MutedBrush}"/>
                  </Grid>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="{Binding Notes,Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,6" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Uuid,Mode=OneWay,StringFormat={}UUID：{0}}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Hex,Mode=OneWay,StringFormat={}原始 HEX：{0}}" FontFamily="{DynamicResource UiCodeFontFamily}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" Visibility="{Binding HasPayload,Converter={StaticResource BoolVisibility},Mode=OneWay}"/>
              </StackPanel>
            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsInvalidPayload,Mode=OneWay}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
          </Border>
        </DataTemplate></DataGrid.RowDetailsTemplate>
      </DataGrid>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,15,0,0" Padding="20">
      <StackPanel><TextBlock Text="{DynamicResource UiText110}" Style="{StaticResource Hint}"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource UiText111}" Command="{Binding WriteDiagnosticCommand}" IsEnabled="{Binding IsConnected}" Margin="12,0,0,0"/><TextBox Text="{Binding RawHex,UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource UiCodeFontFamily}"/></DockPanel>
        <TextBlock Text="{DynamicResource UiText112}" Style="{StaticResource Hint}"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
