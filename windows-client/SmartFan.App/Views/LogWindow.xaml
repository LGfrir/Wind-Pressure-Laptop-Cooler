<Window x:Class="SmartFan.App.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="运行日志与诊断" Width="1040" Height="680" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="运行日志与诊断" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="最近的运行记录仅在此窗口显示；完整异常堆栈保存在磁盘日志中。" Style="{StaticResource Hint}"/>
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,16">
      <Button Content="打开前端日志目录" Click="OpenFrontendLogs"/>
      <Button Content="打开后台日志目录" Click="OpenBackendLogs"/>
      <Button Content="导出前端日志" Click="ExportFrontendLogs"/>
      <Button x:Name="MeasureButton" Content="测量界面流畅度" Click="MeasureRendering"/>
    </WrapPanel>
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" Padding="4">
      <TextBox x:Name="LogContent" IsReadOnly="True" FontFamily="{DynamicResource UiCodeFontFamily}" FontWeight="{DynamicResource UiBodyWeight}"
               FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
               VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="12"/>
    </Border>
    <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <TextBlock x:Name="LogFilePath" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
      <TextBlock x:Name="DiagnosticsStatus" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
  </Grid>
</Window>
