<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>SmartFan.Ui.Tests.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\SmartFan.App\SmartFan.App.csproj" /></ItemGroup>
  <ItemGroup>
    <!-- AppearanceService uses entry-assembly relative theme URIs; link the unchanged production theme sources. -->
    <Page Include="..\SmartFan.App\Themes\Nebula.xaml" Link="Themes\Nebula.xaml" />
    <Page Include="..\SmartFan.App\Themes\Light.xaml" Link="Themes\Light.xaml" />
    <Page Include="..\SmartFan.App\Themes\Cyber.xaml" Link="Themes\Cyber.xaml" />
    <Page Include="..\SmartFan.App\Themes\Graphite.xaml" Link="Themes\Graphite.xaml" />
  </ItemGroup>
</Project>
